#!/usr/bin/env bash

set -eu

if command -v docker &>/dev/null; then
  socket=$(docker context inspect | jq -r ".[].Endpoints.docker.Host" | cut -d':' -f2)
  if [[ -S "$socket" ]]; then
    docker rm -v "$(docker ps -a -q)" 2>/dev/null || true
    docker rmi "$(docker images -a -q)" 2>/dev/null || true
  fi
elif command -v podman &>/dev/null; then
  podman rm -v "$(podman ps -a --external -q)" 2>/dev/null || true
  podman rmi "$(podman images -a -q)" 2>/dev/null || true
fi
