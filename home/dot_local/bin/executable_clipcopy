#!/usr/bin/env bash

set -eu

if type -P pbcopy &>/dev/null; then
  exec pbcopy
elif type -P wl-copy &>/dev/null; then
  exec wl-copy
elif type -P xclip &>/dev/null; then
  exec xclip -selection clipboard
else
  if [ $# -eq 0 ]; then
    cat >/tmp/clipboard
  else
    cat "$1" >/tmp/clipboard
  fi
fi
